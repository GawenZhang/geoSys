# Copy to backend/.env and adjust for your server.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# mysql (server default) or sqlite (local smoke test without MySQL)
DB_ENGINE=mysql
MYSQL_DATABASE=geo_sys
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306

# Comma-separated; required behind HTTPS reverse proxy
# DJANGO_CSRF_TRUSTED_ORIGINS=https://your.domain.com

# AI: stub | demo | proxy
# stub  -> 返回 not_configured
# demo  -> 本地演示文案（无需密钥，便于联调）
# proxy -> 转发到 OpenAI 兼容上游（需配置下方 URL/KEY）
AI_MODE=demo
AI_UPSTREAM_URL=
AI_UPSTREAM_KEY=
AI_UPSTREAM_MODEL=gpt-4o-mini
AI_UPSTREAM_TIMEOUT=60
